---
import Layout from './Layout.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import FloatingContact from '@/components/FloatingContact.astro';
import '@/styles/home-motion.css';
import '@/styles/company-pages.css';
interface Props { title: string; description: string; pageType: 'AboutPage' | 'CollectionPage' | 'FAQPage' | 'ContactPage'; pageData?: Record<string, unknown>; structuredData?: Record<string, unknown>[]; }
const { title, description, pageType, pageData = {}, structuredData = [] } = Astro.props;
const origin = Astro.site ?? new URL('https://example.com');
const pageUrl = new URL(Astro.url.pathname, origin).href;
const schema = [
  { '@type': pageType, '@id': `${pageUrl}#page`, name: title, description, url: pageUrl, about: { '@id': new URL('/#organization', origin).href }, isPartOf: { '@id': new URL('/#website', origin).href }, ...pageData },
  { '@type': 'BreadcrumbList', itemListElement: [{ '@type': 'ListItem', position: 1, name: 'Home', item: origin.href }, { '@type': 'ListItem', position: 2, name: title, item: pageUrl }] },
  ...structuredData,
];
---
<Layout title={title} description={description} structuredData={schema}>
  <Header />
  <main id="main-content" class="company-page" tabindex="-1"><slot /></main>
  <Footer />
  <FloatingContact />
</Layout>
