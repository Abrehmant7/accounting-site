---
import CompanyLayout from '@/layouts/CompanyLayout.astro';
import CompanyCta from '@/components/CompanyCta.astro';
import Icon from '@/components/Icon.astro';
import { workingPrinciples } from '@/data/company';
import { onboardingSteps } from '@/data/home';
import { siteConfig } from '@/config/site';
---
<CompanyLayout title="About Us" description={`Meet ${siteConfig.name}: a thoughtful approach to finance and accounting outsourcing, built around clear responsibilities, connected teams, and your way of working.`} pageType="AboutPage">
  <section class="company-hero about-hero" aria-labelledby="about-heading"><div class="shell">
    <nav class="company-breadcrumb" aria-label="Breadcrumb"><a href="/">Home</a><span aria-hidden="true">/</span><span aria-current="page">About us</span></nav>
    <div class="about-hero-copy"><p class="company-kicker hero-enter">ABOUT {siteConfig.name.toUpperCase()}</p><h1 id="about-heading" class="hero-enter hero-enter-heading">Good with numbers.<br /><span>Better, together.</span></h1><p class="company-hero-intro hero-enter hero-enter-description">Finance works better when the people behind it feel connected. Our approach brings your priorities, the day-to-day work, and the bigger picture into the same conversation.</p><a href="#our-approach" class="company-text-link hero-enter hero-enter-actions">Get to know our approach<Icon name="arrow-right" size={16} /></a></div>
    <div class="about-connection hero-enter hero-enter-audience" aria-hidden="true"><span>YOUR AMBITION</span><div class="about-connection-line"><i></i><i></i><i></i><Icon name="arrow-right" size={17} /></div><span>OUR SHARED DIRECTION</span><svg viewBox="0 0 720 150" fill="none"><path d="M0 120C160 120 160 20 360 20S560 120 720 120M0 100C160 100 180 40 360 40S560 100 720 100M0 80C160 80 180 60 360 60S560 80 720 80" stroke="currentColor" stroke-width=".8" /></svg></div>
  </div></section>
  <section id="our-approach" class="company-perspective" aria-labelledby="perspective-heading"><div class="shell company-perspective-layout"><div class="reveal-on-scroll"><p class="company-kicker">OUR PERSPECTIVE</p><h2 id="perspective-heading">Expertise in the details.<br /><span>Perspective for the bigger picture.</span></h2></div><div class="company-perspective-copy reveal-on-scroll"><p>Every business has its own rhythm. Client deadlines, payroll cycles, month-end reviews, and plans for the next stage all need room in the same working week.</p><p>{siteConfig.name} brings finance and accounting support into that picture. The starting point is understanding the work: what needs attention, how your team operates, and where additional capacity would help.</p><p>From a defined bookkeeping process to an extended offshore team, the aim is a working relationship with clear responsibilities, useful handovers, and an agreed review routine.</p><a href="/#expertise" class="company-text-link">Explore our expertise<Icon name="arrow-up-right" size={16} /></a></div></div></section>
  <section class="company-principles" aria-labelledby="principles-heading"><div class="shell"><div class="company-section-heading reveal-on-scroll"><p class="company-kicker">WHAT GUIDES THE WORK</p><h2 id="principles-heading">A thoughtful approach.<br /><span>In the everyday details.</span></h2></div><div class="company-principles-grid">{workingPrinciples.map(principle=><article class="reveal-on-scroll"><span class="company-index">{principle.number}</span><div><h3>{principle.title}</h3><p>{principle.description}</p></div></article>)}</div></div></section>
  <section class="company-manifesto" aria-labelledby="manifesto-heading"><div class="shell reveal-on-scroll"><p class="company-kicker">THE CONNECTION THAT MATTERS</p><h2 id="manifesto-heading">Different desks.<br />The same <span>direction.</span></h2><p>Outsourcing should feel connected to your business. Your tools, your standards, and your priorities belong at the centre of the working relationship.</p><a href="/who-we-serve/" class="company-text-link">See who we work with<Icon name="arrow-up-right" size={17} /></a></div><div class="manifesto-network" aria-hidden="true"><svg viewBox="0 0 480 380" fill="none"><ellipse cx="240" cy="190" rx="205" ry="105" transform="rotate(-28 240 190)" /><ellipse cx="240" cy="190" rx="205" ry="145" transform="rotate(-28 240 190)" /><path d="m75 95 330 190M75 285 405 95M240 35v310" /><circle cx="240" cy="190" r="42" />{[[75,95],[405,285],[75,285],[405,95],[240,35],[240,345]].map(([cx,cy])=><circle cx={cx} cy={cy} r="6" />)}</svg></div></section>
  <section class="company-working" aria-labelledby="working-heading"><div class="shell"><div class="company-section-heading reveal-on-scroll"><p class="company-kicker">HOW THE RELATIONSHIP TAKES SHAPE</p><h2 id="working-heading">Start with understanding.<br /><span>Build a shared rhythm.</span></h2></div><ol class="company-working-grid">{onboardingSteps.map((step,index)=><li class="reveal-on-scroll"><span>0{index+1}</span><h3>{step.title}</h3><p>{step.description}</p></li>)}</ol></div></section>
  <section class="company-responsibility" aria-labelledby="responsibility-heading"><div class="shell company-responsibility-layout"><div class="reveal-on-scroll"><p class="company-kicker">A CONSIDERED HANDOVER</p><h2 id="responsibility-heading">Clear boundaries.<br /><span>A better connection.</span></h2><p>Access, confidentiality, and review responsibilities belong in the onboarding conversation. Agree the practical details before the work changes hands.</p><a href="/faq/" class="company-text-link">Read our FAQs<Icon name="arrow-right" size={16} /></a></div><div class="company-responsibility-list reveal-on-scroll"><div><Icon name="lock" size={20} /><h3>Access with a purpose.</h3><p>Define the systems, permissions, and information-sharing routes needed for the agreed work.</p></div><div><Icon name="people" size={20} /><h3>People with a clear role.</h3><p>Name the contacts, reviewers, and approvers so questions reach the right person.</p></div><div><Icon name="layers" size={20} /><h3>A handover with context.</h3><p>Agree the outputs, supporting records, and review points your team needs to move the work forward.</p></div></div></div></section>
  <CompanyCta title="Let’s move the work forward, together." description="A little context about your business is a good place to begin." secondaryLabel="Find your fit" secondaryHref="/who-we-serve/" />
</CompanyLayout>
