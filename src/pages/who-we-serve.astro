---
import CompanyLayout from '@/layouts/CompanyLayout.astro';
import CompanyCta from '@/components/CompanyCta.astro';
import Icon from '@/components/Icon.astro';
import { audienceProfiles, readinessQuestions } from '@/data/company';
---
<CompanyLayout title="Who We Serve" description="Finance and accounting outsourcing for UK and US accounting practices, SMEs, owner-led businesses, and growing finance teams. Find the support that fits your workload." pageType="CollectionPage">
  <section class="company-hero audience-hero" aria-labelledby="audience-page-heading"><div class="shell">
    <nav class="company-breadcrumb" aria-label="Breadcrumb"><a href="/">Home</a><span aria-hidden="true">/</span><span aria-current="page">Who we serve</span></nav>
    <div class="audience-hero-layout"><div><p class="company-kicker hero-enter">WHO WE SERVE / BUILT AROUND YOU</p><h1 id="audience-page-heading" class="hero-enter hero-enter-heading">Different businesses.<br /><span>Shared ambition.</span></h1><p class="company-hero-intro hero-enter hero-enter-description">Your finance needs are shaped by where you are, how you work, and where you want to go. The right support should fit that picture.</p><a href="/contact/" class="btn-primary hero-enter hero-enter-actions">Let’s find your fit<Icon name="arrow-up-right" size={17} /></a></div>
      <nav class="audience-selector hero-enter hero-enter-visual" aria-label="Find your audience"><p>FIND YOUR STARTING POINT</p>{audienceProfiles.map(profile=><a href={`#${profile.id}`}><span>{profile.number}</span><div><strong>{profile.number === '01' ? 'Accounting practices' : profile.number === '02' ? 'SMEs & owner-led businesses' : 'Growing finance teams'}</strong><p>{profile.number === '01' ? 'Extend your delivery capacity.' : profile.number === '02' ? 'Bring order to the everyday.' : 'Make room for your next stage.'}</p></div><Icon name="arrow-up-right" size={20} /></a>)}<span class="audience-selector-note">One process or a dedicated team. Start where it helps.</span></nav>
    </div>
  </div></section>
  {audienceProfiles.map(profile=><section id={profile.id} class="audience-story" aria-labelledby={`${profile.id}-heading`}><div class="shell audience-story-layout">
    <div class="audience-story-copy reveal-on-scroll"><p class="company-kicker"><span class="company-index">{profile.number}</span>{profile.label}</p><h2 id={`${profile.id}-heading`}>{profile.title}</h2><p>{profile.intro}</p><a href="/contact/" class="company-text-link">Talk about your workload<Icon name="arrow-up-right" size={16} /></a></div>
    <div class="audience-support reveal-on-scroll"><p class="company-small-label">WHEN SUPPORT CAN MAKE A DIFFERENCE</p><ul class="audience-moments">{profile.moments.map(moment=><li><span aria-hidden="true"></span><p>{moment}</p></li>)}</ul><div class="audience-arrangement"><span class="company-small-label">HOW WE CONNECT</span><p>{profile.arrangement}</p></div><div class="audience-service-links"><p class="company-small-label">A PLACE TO START</p>{profile.startingPoints.map(service=><a href={service.href}>{service.label}<Icon name="arrow-up-right" size={15} /></a>)}</div><p class="audience-scope-note">{profile.note}</p></div>
  </div></section>)}
  <section class="company-readiness" aria-labelledby="readiness-heading"><div class="shell"><div class="company-section-heading reveal-on-scroll"><p class="company-kicker">A USEFUL FIRST CONVERSATION</p><h2 id="readiness-heading">You don’t need all the answers.<br /><span>Just a starting point.</span></h2></div><div class="company-readiness-grid">{readinessQuestions.map(question=><article class="reveal-on-scroll"><span>{question.number}</span><h3>{question.title}</h3><p>{question.description}</p></article>)}</div><div class="company-tools reveal-on-scroll"><div><p class="company-small-label">YOUR SYSTEMS, PART OF THE CONVERSATION</p><p>Tell us what you use. We plan the workflow around your setup.</p></div><ul aria-label="Accounting software to discuss"><li>Xero</li><li>QuickBooks</li><li>Sage</li></ul></div></div></section>
  <CompanyCta title="The right support starts with your business." description="Tell us where the work needs more attention. We’ll explore the fit together." secondaryLabel="Get to know us" secondaryHref="/about/" />
</CompanyLayout>
