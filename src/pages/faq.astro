---
import CompanyLayout from '@/layouts/CompanyLayout.astro';
import CompanyCta from '@/components/CompanyCta.astro';
import Icon from '@/components/Icon.astro';
import { allFaqs, faqGroups } from '@/data/faqs';
import '@/styles/support-pages.css';
const faqSchema = { mainEntity: allFaqs.map(faq => ({ '@type': 'Question', name: faq.question, acceptedAnswer: { '@type': 'Answer', text: faq.answer } })) };
---
<CompanyLayout title="FAQs & Compliance" description="Answers about finance outsourcing, onboarding, accounting software, data access, confidentiality, and review responsibilities. Find a clearer starting point." pageType="FAQPage" pageData={faqSchema}>
  <section class="company-hero support-hero" aria-labelledby="faq-page-heading"><div class="shell"><nav class="company-breadcrumb" aria-label="Breadcrumb"><a href="/">Home</a><span aria-hidden="true">/</span><span aria-current="page">FAQs & compliance</span></nav><div class="support-hero-layout"><div><p class="company-kicker hero-enter">THE DETAILS, EXPLAINED</p><h1 id="faq-page-heading" class="hero-enter hero-enter-heading">Good questions.<br /><span>Clearer next steps.</span></h1><p class="company-hero-intro hero-enter hero-enter-description">From the first conversation to the everyday workflow. Find the details that help you decide what comes next.</p></div><div class="faq-hero-aside hero-enter hero-enter-actions"><Icon name="chat" size={25} /><h2>A conversation can help.</h2><p>Your business has its own context. If you need a more specific answer, tell us a little about it.</p><a href="/contact/" class="company-text-link">Ask us directly<Icon name="arrow-up-right" size={16} /></a></div></div></div></section>
  <section id="answers" class="faq-directory" aria-label="Frequently asked questions"><div class="shell faq-directory-layout">
    <aside class="faq-category-sidebar"><p class="company-small-label">EXPLORE BY TOPIC</p><nav aria-label="FAQ topics">{faqGroups.map(group=><a href={`#${group.id}`} data-faq-category={group.id}><span>{group.number}</span>{group.title}<Icon name="arrow-up-right" size={13} /></a>)}</nav><div class="faq-sidebar-note"><p>Looking for a particular service?</p><a href="/#expertise" class="company-text-link">Explore our expertise<Icon name="arrow-right" size={14} /></a></div></aside>
    <div class="faq-directory-content"><div class="faq-search" data-faq-controls hidden><label for="faq-search-input">Find an answer</label><div><Icon name="search" size={18} /><input id="faq-search-input" data-faq-search type="search" placeholder="Try software, payroll, or data access" autocomplete="off" aria-describedby="faq-search-status" /><button type="button" data-faq-clear hidden>Clear<span class="sr-only"> search</span></button></div></div><p id="faq-search-status" class="faq-search-status" data-faq-status role="status" aria-live="polite" aria-atomic="true">{allFaqs.length} questions, a clearer starting point.</p>
      {faqGroups.map(group=><section id={group.id} class="faq-topic" data-faq-group aria-labelledby={`${group.id}-heading`}><div class="faq-topic-heading"><span>{group.number}</span><div><h2 id={`${group.id}-heading`}>{group.title}</h2><p>{group.description}</p></div></div><div class="help-question-list">{group.questions.map((faq,index)=><details id={faq.id} class="help-question" name="help-centre-faq"><summary><span class="help-question-number">0{index+1}</span><h3>{faq.question}</h3><span class="help-question-toggle" aria-hidden="true"></span></summary><div class="help-answer"><p>{faq.answer}</p></div></details>)}</div></section>)}
      <div class="faq-empty" data-faq-empty hidden><Icon name="search" size={25} /><h2>No matching answers yet.</h2><p>Try a shorter phrase or a different word. You can also ask us directly.</p><a href="/contact/" class="company-text-link">Start a conversation<Icon name="arrow-up-right" size={16} /></a></div>
    </div>
  </div></section>
  <CompanyCta title="Still have something on your mind?" description="Bring your questions. We’ll explore the details around your business." secondaryLabel="See our services" secondaryHref="/#expertise" />
</CompanyLayout>
<script>import '@/scripts/faq-search';</script>
