---
import Icon from './Icon.astro';
import { siteConfig } from '@/config/site';
const { contact } = siteConfig;
const channels = [
  { label: 'WhatsApp', icon: 'chat' as const, href: contact.whatsapp ? `https://wa.me/${contact.whatsapp}` : '', external: true },
  { label: 'Call us', icon: 'phone' as const, href: contact.phone ? `tel:${contact.phone.replace(/[^\d+]/g, '')}` : '', external: false },
  { label: 'Email us', icon: 'mail' as const, href: contact.email ? `mailto:${contact.email}` : '', external: false },
];
---
<aside aria-label="Quick consultation" class="fixed right-5 bottom-5 z-30 sm:right-7 sm:bottom-7">
  <details class="group relative" data-disclosure>
    <summary class="flex h-14 w-14 items-center justify-center rounded-2xl border border-white/20 bg-cobalt text-white shadow-float transition-colors hover:bg-cobalt-hover" aria-label="Quick consultation options">
      <span class="group-open:hidden"><Icon name="chat" size={22} /></span>
      <span class="hidden group-open:block"><Icon name="close" size={22} /></span>
    </summary>
    <div class="contact-popover absolute right-0 bottom-[calc(100%+1rem)] w-[min(19rem,calc(100vw-2.5rem))] rounded-2xl border border-border bg-white p-5 shadow-float">
      <p class="text-sm font-bold text-heading">Let’s find your next step.</p>
      <p class="mt-2 text-xs leading-6 text-muted">Choose how you’d like to connect.</p>
      <ul class="mt-4 space-y-1">
        {channels.map((channel) => <li>{channel.href ? (
          <a href={channel.href} target={channel.external ? '_blank' : undefined} rel={channel.external ? 'noopener noreferrer' : undefined} class="flex min-h-11 items-center gap-3 rounded-lg px-3 py-3 text-xs font-medium hover:bg-canvas hover:text-cobalt"><Icon name={channel.icon} size={17} />{channel.label}{channel.external && <span class="sr-only"> (opens in a new tab)</span>}</a>
        ) : (
          <span aria-disabled="true" class="flex min-h-11 items-center gap-3 rounded-lg px-3 py-3 text-xs text-muted"><Icon name={channel.icon} size={17} /><span>{channel.label}</span><span class="ml-auto text-[0.625rem]">Coming soon</span></span>
        )}</li>)}
      </ul>
      <a href="/contact/" class="mt-3 flex min-h-11 items-center justify-between border-t border-border pt-3 text-xs font-medium text-cobalt">Send an enquiry<Icon name="arrow-up-right" size={15} /></a>
    </div>
  </details>
</aside>
