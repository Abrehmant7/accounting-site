# Copy to .env and replace the placeholders before production deployment.
PUBLIC_SITE_NAME="Your Firm"
PUBLIC_SITE_URL=https://example.com
PUBLIC_CONTACT_EMAIL=
PUBLIC_CONTACT_PHONE=
# International digits only, without + or spaces.
PUBLIC_WHATSAPP_NUMBER=
# Web3Forms access keys are designed to be public browser-side identifiers.
PUBLIC_WEB3FORMS_ACCESS_KEY=
# Enable indexing only after the real brand, domain, content, and contacts are set.
PUBLIC_ALLOW_INDEXING=false
